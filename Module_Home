Function GetGreeting() As String
    Dim h As Integer
    h = Hour(Now)
    If h < 12 Then
        GetGreeting = "Good morning"
    ElseIf h < 18 Then
        GetGreeting = "Good afternoon"
    Else
        GetGreeting = "Good evening"
    End If
End Function

Function GetFriendlyUserName() As String
    Dim rawName As String
    rawName = Application.UserName
    If rawName = "" Then rawName = Environ("USERNAME")
    rawName = Split(rawName, "_")(0)
    rawName = Split(rawName, " ")(0)
    If Len(rawName) > 0 Then
        GetFriendlyUserName = UCase(Left(rawName, 1)) & LCase(Mid(rawName, 2))
    Else
        GetFriendlyUserName = "User"
    End If
End Function

