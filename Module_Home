    Dim adminHeader As Shape
    Set adminHeader = ws.Shapes.AddTextbox(msoTextOrientationHorizontal, rightLeft, adminTop, rightWidth, 18)
    With adminHeader
        .Fill.Visible = msoFalse
        .Line.Visible = msoFalse
        With .TextFrame2
