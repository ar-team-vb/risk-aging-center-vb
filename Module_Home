Sub ListHomeIconSizes()
    Dim ws As Worksheet
    Dim shp As Shape
    Dim msg As String

    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Home")
    On Error GoTo 0
    If ws Is Nothing Then
        MsgBox "Home sheet not found!", vbCritical
        Exit Sub
    End If

    Dim i As Long
    i = 0
    For Each shp In ws.Shapes
        If shp.Type = msoPicture Then
            i = i + 1
            msg = msg & i & ". Name:[" & shp.Name & "]  W:" & Round(shp.Width, 1) & _
                  "  H:" & Round(shp.Height, 1) & "  Left:" & Round(shp.Left, 0) & _
                  "  Top:" & Round(shp.Top, 0) & vbNewLine
        End If
    Next shp

    If msg = "" Then
        MsgBox "No picture shapes found on Home at all!", vbExclamation
    Else
        MsgBox "Picture shapes on Home (" & i & " total):" & vbNewLine & vbNewLine & msg, vbInformation
    End If
End Sub


'============================================================
' LETTER-SPACE HELPER - USES A THIN SPACE FOR ELEGANT TRACKING
'============================================================
Function LetterSpace(txt As String, Optional useThinSpace As Boolean = True) As String
    Dim i As Long, result As String, spacer As String
    If useThinSpace Then
        spacer = ChrW(8201)
    Else
        spacer = " "
    End If
    For i = 1 To Len(txt)
        result = result & Mid(txt, i, 1)
        If i < Len(txt) Then result = result & spacer
    Next i
    LetterSpace = result
End Function
