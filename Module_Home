Sub UpdateHeaderDateTime()
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Home")
    On Error GoTo 0
    If ws Is Nothing Then Exit Sub

    On Error Resume Next
    ws.Shapes("lblHeaderDate").TextFrame2.TextRange.Text = Format(Now, "ddd, dd MMM yyyy")
