'============================================================
' DRAW A GRID OF DASHBOARD CARDS - RETURNS THE BOTTOM Y POSITION
'============================================================
Function DrawCardGrid(ws As Worksheet, cards As Variant, leftPos As Double, topPos As Double, _
                       colWidth As Double, rowHeight As Double, colGap As Double, rowGap As Double, cols As Long, _
                       cardBg As Long, borderClr As Long, iconBoxClr As Long, iconClr As Long, titleClr As Long, descClr As Long) As Double
    Dim i As Long, r As Long, c As Long
    Dim curLeft As Double, curTop As Double

    For i = LBound(cards) To UBound(cards)
        r = i \ cols
        c = i Mod cols
        curLeft = leftPos + c * (colWidth + colGap)
        curTop = topPos + r * (rowHeight + rowGap)

        AddDashboardCard ws, curLeft, curTop, colWidth, rowHeight, _
            CStr(cards(i)(0)), CStr(cards(i)(1)), CStr(cards(i)(2)), CStr(cards(i)(3)), _
            cardBg, borderClr, iconBoxClr, iconClr, titleClr, descClr
    Next i

    Dim totalRows As Long
    totalRows = ((UBound(cards) - LBound(cards)) \ cols) + 1
    DrawCardGrid = topPos + totalRows * rowHeight + (totalRows - 1) * rowGap
End Function

